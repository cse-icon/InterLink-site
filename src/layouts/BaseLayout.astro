---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { navFor, type NavLink, type Product } from '../lib/products';

interface Props {
  title: string;
  description?: string;
  /** When set, the nav is scoped to this product and shows its links. */
  product?: Product;
  /** Href of the nav link to mark current, e.g. `/interlink/roadmap`. */
  activeHref?: string;
  /** Other published products, for the switcher menu. */
  siblings?: Product[];
  footerVariant?: 'plain' | 'brand';
  /** Root-relative OG image path. */
  ogImage?: string;
}

const {
  title,
  description = 'Product sites and public roadmaps for CSE ICON software.',
  product,
  activeHref,
  siblings = [],
  footerVariant = 'plain',
  ogImage = '/cse-icon-logo.png',
} = Astro.props;

const links: NavLink[] = product ? navFor(product) : [];
const others = siblings.filter((p) => p.id !== product?.id);

// Astro.site comes from `site` in astro.config.mjs; the fallback keeps this
// resolvable if the config is ever missing a site URL.
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://products.cse-icon.com');
const ogImageUrl = new URL(ogImage, canonical);

const navLinkClass = (href: string) =>
  href === activeHref
    ? 'text-sm font-semibold text-brand-600 transition-colors dark:text-brand-400'
    : 'text-sm font-semibold text-[var(--color-text-muted)] transition-colors hover:text-brand-600';

const footerLinkClass =
  footerVariant === 'brand'
    ? 'text-white/80 transition-colors hover:text-white'
    : 'text-[var(--color-text-muted)] transition-colors hover:text-brand-600';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CSE ICON Products" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />

    <script is:inline>
      if (
        localStorage.getItem('theme') === 'dark' ||
        (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Top bar (CSE ICON red) -->
    <div class="bg-brand-600 text-white text-xs py-1.5">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="https://cse-icon.com" class="font-semibold hover:text-white/80 transition-colors">CSE ICON, Inc.</a>
        <a href="mailto:sales@cse-icon.com" class="hover:text-white/80 transition-colors">sales@cse-icon.com</a>
      </div>
    </div>

    <!-- Main nav -->
    <nav class="sticky top-0 z-50 bg-white shadow-[0_1px_0_rgba(0,0,0,0.1)] dark:bg-slate-900 dark:shadow-[0_1px_0_rgba(255,255,255,0.05)]">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
        <a href={product ? `/${product.id}` : '/'} class="flex min-w-0 items-center gap-3">
          <img src="/cse-icon-logo.png" alt="CSE ICON" class="h-8 shrink-0 dark:brightness-0 dark:invert" />
          <span class="text-[var(--color-text-muted)]">|</span>
          <span class="truncate text-lg font-bold tracking-tight text-[var(--color-text)]">
            {product ? product.data.name : 'Products'}
          </span>
        </a>

        <div class="flex items-center gap-3 sm:gap-6">
          {links.map((link) => (
            <a
              href={link.href}
              aria-current={link.href === activeHref ? 'page' : undefined}
              class={navLinkClass(link.href)}
            >
              {link.label}
            </a>
          ))}

          {others.length > 0 && (
            <div class="relative" id="product-switcher">
              <button
                id="product-switcher-button"
                type="button"
                aria-expanded="false"
                aria-haspopup="true"
                class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-text-muted)] transition-colors hover:text-brand-600"
              >
                {product ? 'More' : 'Products'}
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </button>
              <div
                id="product-switcher-menu"
                class="absolute right-0 z-50 mt-2 hidden w-56 overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] py-1 shadow-xl"
              >
                {others.map((p) => (
                  <a
                    href={`/${p.id}`}
                    class="block px-4 py-2 text-sm text-[var(--color-text)] transition-colors hover:bg-[var(--color-surface)] hover:text-brand-600"
                  >
                    {p.data.name}
                  </a>
                ))}
                <a
                  href="/"
                  class="block border-t border-[var(--color-border)] px-4 py-2 text-sm text-[var(--color-text-muted)] transition-colors hover:bg-[var(--color-surface)] hover:text-brand-600"
                >
                  All products
                </a>
              </div>
            </div>
          )}

          <button
            id="theme-toggle"
            class="rounded-lg p-2 text-[var(--color-text-muted)] transition-colors hover:bg-gray-100 hover:text-[var(--color-text)] dark:hover:bg-slate-800"
            aria-label="Toggle dark mode"
          >
            <svg class="h-5 w-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
            </svg>
            <svg class="hidden h-5 w-5 dark:block" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
            </svg>
          </button>
        </div>
      </div>
    </nav>

    <main class="flex-1">
      <slot />
    </main>

    <Footer variant={footerVariant} linkClass={footerLinkClass} />

    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });

      // Product switcher dropdown
      const switcher = document.getElementById('product-switcher');
      const switcherButton = document.getElementById('product-switcher-button');
      const switcherMenu = document.getElementById('product-switcher-menu');

      function closeSwitcher() {
        switcherMenu?.classList.add('hidden');
        switcherButton?.setAttribute('aria-expanded', 'false');
      }

      switcherButton?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = switcherMenu?.classList.toggle('hidden');
        switcherButton.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
      });

      document.addEventListener('click', (e) => {
        if (switcher && !switcher.contains(e.target as Node)) closeSwitcher();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeSwitcher();
      });
    </script>
  </body>
</html>
