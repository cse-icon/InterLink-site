---
import RoadmapItem from './RoadmapItem.astro';
import { ROADMAP_COLUMNS, categoryBadge } from '../lib/roadmap';
import type { RoadmapItem as RoadmapEntry } from '../lib/roadmap';

interface Props {
  items: RoadmapEntry[];
}

const { items } = Astro.props;

const categories = [...new Set(items.map((i) => i.category))].sort();
---

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <!-- Category filter -->
  <div class="mb-8 flex flex-wrap items-center gap-2">
    <span class="text-sm font-medium text-[var(--color-text-muted)]">Filter:</span>
    <button
      class="category-filter badge badge-platform active-filter rounded-lg px-3 py-1.5 text-sm font-medium transition-colors"
      data-category="all"
    >
      All
    </button>
    {categories.map((cat) => (
      <button
        class={`category-filter badge ${categoryBadge(cat)} rounded-lg px-3 py-1.5 text-sm font-medium opacity-60 transition-all hover:opacity-100`}
        data-category={cat}
      >
        {cat}
      </button>
    ))}
  </div>

  <!-- Kanban board -->
  <div class="grid gap-6 lg:grid-cols-4">
    {ROADMAP_COLUMNS.map((col) => {
      const colItems = items.filter((i) => i.status === col.key);
      return (
        <div class="flex flex-col">
          <div class="mb-4 flex items-center gap-2">
            <div class={`h-2.5 w-2.5 rounded-full ${col.color}`} />
            <h3 class="text-sm font-semibold">{col.label}</h3>
            <span class="text-xs text-[var(--color-text-muted)]">({colItems.length})</span>
          </div>
          <div class="flex flex-col gap-3 roadmap-column" data-column-status={col.key}>
            {colItems.map((item) => (
              <RoadmapItem {...item} />
            ))}
            {colItems.length === 0 && (
              <p class="rounded-lg border border-dashed border-[var(--color-border)] p-6 text-center text-sm text-[var(--color-text-muted)]">
                No items yet
              </p>
            )}
          </div>
        </div>
      );
    })}
  </div>
</div>

<script>
  // Category filtering
  const filters = document.querySelectorAll<HTMLButtonElement>('.category-filter');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.category;

      filters.forEach((f) => {
        f.classList.toggle('opacity-60', f !== btn);
        f.classList.toggle('active-filter', f === btn);
      });

      cards.forEach((card) => {
        if (card.classList.contains('category-filter')) return;
        if (cat === 'all' || card.dataset.category === cat) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Fetch live vote counts from API
  const API_URL = import.meta.env.PUBLIC_VOTE_API_URL || '';
  if (API_URL) {
    const voteButtons = document.querySelectorAll<HTMLButtonElement>('.vote-button');
    voteButtons.forEach(async (btn) => {
      const itemId = btn.dataset.itemId;
      if (!itemId) return;
      try {
        const res = await fetch(`${API_URL}/api/vote/${itemId}`);
        if (res.ok) {
          const data = await res.json();
          const countEl = btn.querySelector('.vote-count');
          if (countEl && data.count !== undefined) {
            countEl.textContent = String(data.count);
          }
        }
      } catch {
        // Silent fail — static count stays as fallback
      }
    });
  }
</script>
