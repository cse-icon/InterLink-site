---
import { icons } from '../lib/icons';
import type { ProductVariant } from '../lib/products';
import { render } from 'astro:content';

interface Props {
  variant: ProductVariant;
  /** Alternate the layout, matching the feature sections above. */
  reversed?: boolean;
}

const { variant, reversed = false } = Astro.props;
const { name, anchor, tagline, icon, highlights } = variant.data;
const { Content } = await render(variant);
---

<section id={anchor} class="scroll-mt-20 border-t border-[var(--color-border)] py-10 sm:py-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class:list={[
        'flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-12',
        reversed && 'lg:flex-row-reverse',
      ]}
    >
      <div class="lg:w-1/3 lg:sticky lg:top-24">
        <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-700 dark:bg-brand-900/30 dark:text-brand-400">
          <Fragment set:html={icons[icon]} />
        </div>
        <h2 class="section-heading mt-3">{name}</h2>
        <p class="section-description">{tagline}</p>
      </div>

      <div class="flex-1">
        <div class="grid gap-3 sm:grid-cols-2">
          {highlights.map((h) => (
            <div class="card">
              <h3 class="text-base font-semibold leading-tight">{h.title}</h3>
              <p class="mt-1 text-sm text-[var(--color-text-muted)]">{h.description}</p>
            </div>
          ))}
        </div>
        <div class="prose prose-sm dark:prose-invert mt-6 max-w-none text-[var(--color-text-muted)]">
          <Content />
        </div>
      </div>
    </div>
  </div>
</section>
