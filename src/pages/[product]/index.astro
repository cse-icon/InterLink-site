---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import FeatureSection from '../../components/FeatureSection.astro';
import ImageBreak from '../../components/ImageBreak.astro';
import VariantSection from '../../components/VariantSection.astro';
import { icons } from '../../lib/icons';
import { getProducts, getSectionsFor, getVariantsFor } from '../../lib/products';

export async function getStaticPaths() {
  const products = await getProducts();

  return Promise.all(
    products.map(async (product) => ({
      params: { product: product.id },
      props: {
        product,
        siblings: products,
        sections: await getSectionsFor(product.id),
        variants: await getVariantsFor(product.id),
      },
    })),
  );
}

const { product, siblings, sections, variants } = Astro.props;
const { name, tagline, subtitle, heroImage, endorsement, cta, seo, roadmap } = product.data;

/** Section anchor from its filename, e.g. `interlink/sections/01-security` -> `security`. */
const anchorFor = (id: string) =>
  id.split('/').pop()!.replace(/^\d+-/, '');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  product={product}
  siblings={siblings}
  activeHref={`/${product.id}`}
  footerVariant="brand"
>
  <Hero
    title={name}
    tagline={tagline}
    subtitle={subtitle}
    backgroundImage={heroImage}
    primaryCta={
      roadmap.enabled
        ? { label: 'View Roadmap', href: `/${product.id}/roadmap` }
        : undefined
    }
    secondaryCta={{ label: 'Contact Sales', href: `mailto:${cta.contactEmail}` }}
  />

  {sections.map((section, i) => (
    <>
      <FeatureSection
        id={anchorFor(section.id)}
        title={section.data.title}
        description={section.data.description}
        icon={icons[section.data.icon]}
        features={section.data.features}
        reversed={i % 2 === 1}
      />
      {section.data.imageBreakAfter && (
        <ImageBreak
          src={section.data.imageBreakAfter.src}
          alt={section.data.imageBreakAfter.alt}
          caption={section.data.imageBreakAfter.caption}
          variant={section.data.imageBreakAfter.variant}
          background={section.data.imageBreakAfter.background}
        />
      )}
    </>
  ))}

  {variants.length > 0 && (
    <div class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8">
      <h2 class="section-heading">Available servers</h2>
      <p class="section-description">Jump to a specific server.</p>
      <div class="mt-4 flex flex-wrap gap-2">
        {variants.map((variant) => (
          <a
            href={`#${variant.data.anchor}`}
            class="badge badge-platform rounded-lg px-3 py-1.5 text-sm font-medium transition-opacity hover:opacity-80"
          >
            {variant.data.name}
          </a>
        ))}
      </div>
    </div>
  )}

  {variants.map((variant, i) => (
    <VariantSection variant={variant} reversed={i % 2 === 1} />
  ))}

  {endorsement && (
    <section class="py-8 sm:py-10">
      <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
        <img src={endorsement.image} alt={endorsement.alt} class="mx-auto h-28 sm:h-32" loading="lazy" />
        <p class="mt-3 text-sm text-[var(--color-text-muted)]">{endorsement.caption}</p>
      </div>
    </section>
  )}

  <section class="bg-gradient-to-r from-brand-600 to-brand-800 py-10 sm:py-14">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        {cta.heading}
      </h2>
      <p class="mt-4 text-lg text-brand-100">
        {cta.body}
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        {roadmap.enabled && (
          <a
            href={`/${product.id}/roadmap`}
            class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-brand-700 shadow-lg transition-all hover:bg-brand-50"
          >
            View Roadmap
          </a>
        )}
        <a
          href={`mailto:${cta.contactEmail}`}
          class="inline-flex items-center gap-2 rounded-lg border border-white/25 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-white/10"
        >
          Contact Sales
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
